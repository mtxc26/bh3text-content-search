<!DOCTYPE html>
<html lang="zh-CN" class="search-app">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>搜索「{{q}}」 - 《崩坏3》文本搜索</title>
<meta name="description" content="《崩坏3》对话文本搜索：{{q}}" />
<link rel="stylesheet" href="/r/static/basic.css" />
<link rel="stylesheet" href="/r/static/style.css" />
<link rel="stylesheet" href="/r/static/search.css" />
</head>
<body>
<a class="skip-link" href="#main-content">转到内容</a>
<div class="search-box">
  <h1 style="text-align:center;font-size:1.3rem;margin-bottom:0.75rem;">《崩坏3》对话文本搜索</h1>
  <form action="/search/" method="get">
    <input type="search" name="q" value="{{q}}" placeholder="输入关键词搜索..." autofocus />
    <button type="submit">搜索</button>
  </form>
  {{#if showInfo}}
  <p class="search-info">找到约 {{totalCount}} 条匹配{{#if showRange}}，显示第 {{rangeStart}}-{{rangeEnd}} 条{{/if}}</p>
  {{/if}}
</div>

<main id="main-content">
{{#if results.length}}
  {{#each results}}
  <article class="result-item">
    <div class="result-header">
      <a href="javascript:void 0">{{chapterTitle}}</a>
      <span class="meta">{{stageId}} · {{matchCount}} 条匹配</span>
    </div>
    <div class="result-lines">
      {{#each lines}}
      <div class="dialog-line{{#if match}} match{{/if}}">
        {{#if actor}}<span class="dialog-actor">{{actor}}：</span>{{/if}}
        <span class="dialog-content">{{{content}}}</span>
      </div>
      {{/each}}
    </div>
  </article>
  {{/each}}

  {{#if hasMore}}
  <div class="pagination">
    <a href="/search?q={{encodedQ}}&amp;offset={{nextOffset}}&amp;limit={{limit}}">下一页</a>
  </div>
  {{/if}}
{{else}}
  <div class="empty">
    {{#if q}}
    未找到与「<strong>{{q}}</strong>」相关的结果。<br>请尝试其他关键词。
    {{else}}
    <span></span>
    {{/if}}
  </div>
{{/if}}
</main>

<footer id=site_footer>
    <a href="/">首页</a>
    <span>|</span>
    <a href="/about/">关于</a>
    <span>|</span>
    <div id=privacy_consent></div>
</footer>

<script type="module" src="/r/runtime/common.js"></script>

</body>
</html>
